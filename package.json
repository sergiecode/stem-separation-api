{
  "name": "stem-separation-api",
  "version": "1.0.0",
  "description": "Node.js API for audio stem separation using AI - Created by Sergie Code",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install-setup": "node install.js",
    "check": "node setup-check.js",
    "build": "echo 'No build step required for Node.js API'",
    "postinstall": "node setup-check.js",
    "docker:build": "docker build -t stem-separation-api .",
    "docker:run": "docker run -p 3000:3000 -v $(pwd)/uploads:/app/uploads -v $(pwd)/output:/app/output stem-separation-api",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop stem-separation-api",
    "pm2:restart": "pm2 restart stem-separation-api"
  },
  "keywords": [
    "audio",
    "stem-separation",
    "ai",
    "music",
    "api",
    "demucs",
    "nodejs"
  ],
  "author": "Sergie Code <sergiecodeteach@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "form-data": "^4.0.4",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "eslint-config-node": "^4.1.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!jest.config.js",
      "!ecosystem.config.js",
      "!examples/**",
      "!uploads/**",
      "!output/**",
      "!logs/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergieCode/stem-separation-api.git"
  },
  "bugs": {
    "url": "https://github.com/sergieCode/stem-separation-api/issues"
  },
  "homepage": "https://github.com/sergieCode/stem-separation-api#readme"
}
